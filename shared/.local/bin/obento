#!/usr/bin/env bash
# obento 🍱 — manage this dotfiles/tools repo.
#
#   obento update        git pull + re-run setup.sh (aborts on conflicts)
#   obento link          link shared + this platform's package into $HOME
#   obento add <path>    move a config into the current platform and link it
#   obento move <dest>   move this repo to <dest> and repoint every link
#
# Finds the repo via $OBENTO_PATH (set by setup.sh); falls back to resolving
# this script's own location, since it's linked from <repo>/shared/.local/bin.
set -euo pipefail
export LC_ALL=C # one sort order for sort and comm

resolve_repo() {
  if [[ -n "${OBENTO_PATH:-}" ]]; then
    printf '%s\n' "$OBENTO_PATH"
    return
  fi
  local src="${BASH_SOURCE[0]}" dir
  while [[ -L "$src" ]]; do
    dir="$(cd "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  # <repo>/shared/.local/bin/obento -> up three dirs is <repo>
  (cd "$(dirname "$src")/../../.." && pwd)
}

platform() {
  case "$(uname -s)" in
    Darwin) echo macos ;;
    Linux)  echo linux ;;
    *) echo "obento: unsupported OS: $(uname -s)" >&2; exit 1 ;;
  esac
}

REPO="$(resolve_repo)"
PKGS=(shared "$(platform)")

cmd_update() {
  echo "Updating obento in $REPO..."
  git -C "$REPO" pull --ff-only ||
    { echo "obento: git pull failed (conflicts/dirty tree?). Aborting." >&2; exit 1; }
  "$REPO/setup.sh"
}

# Is link $1 ours: does it point at <pkg>/<its path under $HOME>, wherever the
# repo lives or used to live? That covers stow's relative links too.
ours() {
  local l k
  l="$(readlink "$1")" || return 1
  for k in "${PKGS[@]}"; do [[ "$l" == */"$k/${1#"$HOME"/}" ]] && return 0; done
  return 1
}

# Move $1 out of the way to $1.obento-bak[N]. Nothing that isn't ours is deleted.
aside() {
  local n=""
  while [[ -e "$1.obento-bak$n" || -L "$1.obento-bak$n" ]]; do n=$((n + 1)); done
  mv "$1" "$1.obento-bak$n"
  echo "moved aside: $1.obento-bak$n" >&2
}

# Link every file git sees in the packages (tracked or untracked, minus ignored)
# into $HOME, one link per file inside real dirs. A dir with its own .gitignore
# is linked whole instead: the app writes runtime state there, and that
# .gitignore keeps it out of git.
# Safe to re-run over any state: links into the packages are repointed, parent
# dirs that are links into the packages (stow's folds) are split into real dirs,
# and anything else in the way is moved aside. Links the last run made that are
# no longer wanted are removed; that list lives in .git, so it moves with the repo.
cmd_link() {
  local state="$REPO/.git/obento-links" files want f w t p c whole=()
  files="$(git -C "$REPO" ls-files -co --exclude-standard -- "${PKGS[@]/%//.*}")"
  while IFS= read -r f; do
    [[ "$f" == */*/.gitignore ]] && whole+=("${f%/.gitignore}")
  done <<<"$files"
  want="$(while IFS= read -r f; do
    [[ -e "$REPO/$f" ]] || continue # deleted, not yet committed
    for w in ${whole[@]+"${whole[@]}"}; do [[ "$f" == "$w"/* ]] && f="$w"; done
    echo "$f"
  done <<<"$files" | sort -u)"

  if [[ -f "$state" ]]; then
    comm -23 "$state" - <<<"$want" | while IFS= read -r f; do
      t="$HOME/${f#*/}"
      if [[ -L "$t" ]] && ours "$t"; then rm "$t" && echo "unlink $t"; fi
    done
  fi

  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    t="$HOME/${f#*/}"
    [[ "$(readlink "$t")" == "$REPO/$f" ]] && continue
    p="$HOME" c="${f#*/}"
    while [[ "$c" == */* ]]; do # every parent must be a real dir (or someone else's link to one)
      p="$p/${c%%/*}" c="${c#*/}"
      if [[ -L "$p" ]] && ours "$p"; then rm "$p"
      elif [[ (-e "$p" || -L "$p") && ! -d "$p" ]]; then aside "$p"
      fi
    done
    mkdir -p "$(dirname "$t")"
    if [[ -d "$t" && ! -L "$t" ]]; then # a real dir where a whole-dir link goes: drop our old links in it
      find "$t" -type l | while IFS= read -r l; do if ours "$l"; then rm "$l"; fi; done
      find "$t" -depth -type d -empty -delete
    fi
    if [[ -L "$t" ]] && ours "$t"; then :
    elif [[ -e "$t" || -L "$t" ]]; then aside "$t"
    fi
    ln -sfn "$REPO/$f" "$t"
    echo "link $t"
  done <<<"$want"
  echo "$want" >"$state"
}

cmd_add() {
  local target="${1:-}"
  [[ -n "$target" ]] || { echo "usage: obento add <path>" >&2; exit 1; }

  # Expand a leading ~ (in case the path was quoted) and make it absolute.
  [[ "$target" == "~/"* ]] && target="$HOME/${target#"~/"}"
  target="$(cd "$(dirname "$target")" && pwd)/$(basename "$target")"
  [[ -e "$target" ]] || { echo "obento: no such path: $target" >&2; exit 1; }
  [[ -L "$target" ]] && { echo "obento: already a symlink, skipping: $target"; exit 0; }

  # Must live under $HOME so it can be linked back there.
  case "$target" in
    "$HOME"/*) ;;
    *) echo "obento: path must be under \$HOME: $target" >&2; exit 1 ;;
  esac

  local rel="${target#"$HOME"/}"
  local plat dest
  plat="$(platform)"
  dest="$REPO/$plat/$rel"

  echo "Adding $rel -> $plat"
  mkdir -p "$(dirname "$dest")"
  mv "$target" "$dest"
  cmd_link
}

cmd_move() {
  local dest="${1:-}" src="$REPO" w
  [[ -n "$dest" ]] || { echo "usage: obento move <dest>" >&2; exit 1; }
  [[ "$dest" == "~/"* ]] && dest="$HOME/${dest#"~/"}"
  mkdir -p "$(dirname "$dest")"
  dest="$(cd "$(dirname "$dest")" && pwd)/$(basename "$dest")"
  [[ "$dest/" != "$src"/* ]] || { echo "obento: $dest is inside $src" >&2; exit 1; }

  if [[ -L "$src" && "$(readlink "$src")" == "$dest" ]]; then
    echo "Resuming the move to $dest"
  else
    [[ ! -e "$dest" ]] || { echo "obento: $dest already exists" >&2; exit 1; }
    echo "Moving $src -> $dest"
    mv "$src" "$dest"
    # Keep the old path working until every link points at the new one.
    ln -s "$dest" "$src"
  fi
  trap 'echo "obento: move did not finish; $src still points to $dest, so nothing is broken. Fix the error above and run \`obento move $dest\` again." >&2' EXIT

  REPO="$dest"
  cmd_link

  # Linked worktrees still point at the old path; nested ones moved along.
  git -C "$dest" worktree list --porcelain | sed -n 's/^worktree //p' | while IFS= read -r w; do
    [[ "$w" == "$src"/* ]] && w="$dest/${w#"$src"/}"
    [[ "$w" == "$dest" ]] || git -C "$dest" worktree repair "$w" ||
      echo "obento: could not repair worktree $w" >&2
  done

  # Same OBENTO_PATH line setup.sh writes.
  local env="$HOME/.config/zsh/local.zshenv"
  { grep -v '^export OBENTO_PATH=' "$env" 2>/dev/null || true; printf 'export OBENTO_PATH=%q\n' "$dest"; } >"$env.tmp"
  mv "$env.tmp" "$env"

  rm "$src"
  trap - EXIT
  echo "Moved to $dest. Restart your shell (exec zsh) to pick up the new \$OBENTO_PATH."
}

case "${1:-}" in
  update) shift; cmd_update "$@" ;;
  link)   cmd_link ;;
  add)    shift; cmd_add "$@" ;;
  move)   shift; cmd_move "$@" ;;
  *) echo "usage: obento {update|link|add <path>|move <dest>}" >&2; exit 1 ;;
esac
